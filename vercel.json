{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.comunidadeora.com.br"
        }
      ],
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/:rota(checkout|obrigada|termos|privacidade)/:resto*",
      "has": [
        {
          "type": "host",
          "value": "app.comunidadeora.com.br"
        }
      ],
      "destination": "https://comunidadeora.com.br/:rota/:resto*",
      "permanent": false
    },
    {
      "source": "/:rota(app|entrar|definir-senha)/:resto*",
      "has": [
        {
          "type": "host",
          "value": "comunidadeora.com.br"
        }
      ],
      "destination": "https://app.comunidadeora.com.br/:rota/:resto*",
      "permanent": false
    },
    {
      "source": "/:rota(app|entrar|definir-senha)/:resto*",
      "has": [
        {
          "type": "host",
          "value": "www.comunidadeora.com.br"
        }
      ],
      "destination": "https://app.comunidadeora.com.br/:rota/:resto*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
